{
  "name": "donkeyride-relay",
  "version": "1.0.0",
  "description": "DonkeyRide stake relay operator server - run your own and earn fees",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/**/*.test.js",
    "test:e2e": "node scripts/e2e-lifecycle.js",
    "test:regtest": "tests/regtest/run.sh",
    "dev:nix": "nix run .#services & npm run dev",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web run test",
    "docker:build": "docker build -t donkeyride-relay .",
    "docker:run": "docker run -p 3000:3000 -p 3001:3001 --env-file .env donkeyride-relay"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "clightning-client": "^0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ln-service": "^56.0.0",
    "node-fetch": "^2.7.0",
    "nostr-tools": "^1.17.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "DonkeyRide Community",
  "license": "MIT"
}
