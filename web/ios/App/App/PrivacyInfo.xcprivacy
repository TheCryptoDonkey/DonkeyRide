<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest for the DonkeyRide Driver app.

	  Apple requires this to describe what the APP'S OWN binary does. The
	  Capacitor and Cordova xcframeworks ship their own manifests covering
	  their required-reason API use, and this target's Swift (AppDelegate,
	  SceneDelegate, ShiftLocationPlugin) calls none of the required-reason
	  APIs itself — hence the empty NSPrivacyAccessedAPITypes.

	  What it DOES do is send a working driver's position to an operator, so
	  that is declared rather than glossed. Everything else the app holds —
	  saved places, guardian contacts, trip history, recordings, the private
	  key itself — stays on the device and never reaches a server, so it is
	  not "collected" in Apple's sense and is not listed here.
	-->

	<!-- No advertising or cross-app measurement of any kind. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
		  Position while on shift. This is the product: dispatch is
		  geographic, and the rider watching the car approach is watching
		  this. It stops when the driver goes offline.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  The driver's Nostr public key. There is no sign-up, no email and no
		  phone number — the key IS the account, generated on the device. It
		  is linked to the location above, which is why "Linked" is true.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  How the driver wants to be paid — a Lightning address, or an M-Pesa
		  number — passed to the operator so it can tell the rider where to
		  send the fare. The operator never receives or holds the money
		  itself; it only carries the handle.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePaymentInfo</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
